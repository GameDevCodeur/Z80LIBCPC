
;------------------------------------------------------------
; GATE ARRAY — CONSTANTES
;------------------------------------------------------------

GA_PORT_CMD			      EQU #7F00	              ; -- Gate Array command port
GA_PORT_CMD_B		      EQU #7F	              ; -- High byte of GA_PORT_CMD

GA_CMD_PEN_SELECT	      EQU %00000000           ; -- select active pen
GA_CMD_COLOR_SET	      EQU %01000000           ; -- set colour for selected pen
GA_CMD_MODE_ROM		      EQU %10000000           ; -- screen mode and ROM enable/disable (RMR)

GA_MODE_0		          EQU GA_CMD_MODE_ROM|0   ; -- Mode 0: 160x200, 16 colours
GA_MODE_1		          EQU GA_CMD_MODE_ROM|1   ; -- Mode 1: 320x200,  4 colours
GA_MODE_2		          EQU GA_CMD_MODE_ROM|2   ; -- Mode 2: 640x200,  2 colours
GA_MODE_3		          EQU GA_CMD_MODE_ROM|3   ; -- Mode 3: undocumented -- avoid

GA_LROM_ENABLE	          EQU %00000000 		  ; bit 2 = 0: lower ROM enabled
GA_LROM_DISABLE	          EQU %00000100 		  ; bit 2 = 1: lower ROM disabled (RAM visible)
GA_UROM_ENABLE	          EQU %00000000			  ; bit 3 = 0: upper ROM enabled
GA_UROM_DISABLE	          EQU %00001000			  ; bit 3 = 1: upper ROM disabled (RAM visible)
GA_IRQ_RESET	          EQU %00010000			  ; bit 4 = 1: reset GA interrupt line counter

GA_PEN_0			      EQU GA_CMD_PEN_SELECT|0
GA_PEN_1			      EQU GA_CMD_PEN_SELECT|1
GA_PEN_2			      EQU GA_CMD_PEN_SELECT|2
GA_PEN_3			      EQU GA_CMD_PEN_SELECT|3
GA_PEN_4			      EQU GA_CMD_PEN_SELECT|4
GA_PEN_5			      EQU GA_CMD_PEN_SELECT|5
GA_PEN_6			      EQU GA_CMD_PEN_SELECT|6
GA_PEN_7			      EQU GA_CMD_PEN_SELECT|7
GA_PEN_8			      EQU GA_CMD_PEN_SELECT|8
GA_PEN_9			      EQU GA_CMD_PEN_SELECT|9
GA_PEN_10			      EQU GA_CMD_PEN_SELECT|10
GA_PEN_11			      EQU GA_CMD_PEN_SELECT|11
GA_PEN_12			      EQU GA_CMD_PEN_SELECT|12
GA_PEN_13			      EQU GA_CMD_PEN_SELECT|13
GA_PEN_14			      EQU GA_CMD_PEN_SELECT|14
GA_PEN_15			      EQU GA_CMD_PEN_SELECT|15
GA_PEN_BORDER             EQU GA_CMD_PEN_SELECT|16

GA_COLOR_BLACK            EQU GA_CMD_COLOR_SET|20 ;  0
GA_COLOR_BLUE             EQU GA_CMD_COLOR_SET|04 ;  1
GA_COLOR_BRIGHT_BLUE      EQU GA_CMD_COLOR_SET|21 ;  2
GA_COLOR_RED              EQU GA_CMD_COLOR_SET|28 ;  3
GA_COLOR_MAGENTA          EQU GA_CMD_COLOR_SET|24 ;  4
GA_COLOR_MAUVE            EQU GA_CMD_COLOR_SET|29 ;  5
GA_COLOR_BRIGHT_RED       EQU GA_CMD_COLOR_SET|12 ;  6
GA_COLOR_PURPLE           EQU GA_CMD_COLOR_SET|05 ;  7
GA_COLOR_BRIGHT_MAGENTA   EQU GA_CMD_COLOR_SET|13 ;  8
GA_COLOR_GREEN            EQU GA_CMD_COLOR_SET|18 ;  9
GA_COLOR_CYAN             EQU GA_CMD_COLOR_SET|06 ; 10
GA_COLOR_SKY_BLUE         EQU GA_CMD_COLOR_SET|23 ; 11
GA_COLOR_YELLOW           EQU GA_CMD_COLOR_SET|30 ; 12
GA_COLOR_WHITE            EQU GA_CMD_COLOR_SET|00 ; 13
GA_COLOR_PASTEL_BLUE      EQU GA_CMD_COLOR_SET|31 ; 14
GA_COLOR_ORANGE           EQU GA_CMD_COLOR_SET|14 ; 15
GA_COLOR_PINK             EQU GA_CMD_COLOR_SET|07 ; 16
GA_COLOR_PASTEL_MAGENTA   EQU GA_CMD_COLOR_SET|15 ; 17
GA_COLOR_BRIGHT_GREEN     EQU GA_CMD_COLOR_SET|18 ; 18
GA_COLOR_SEA_GREEN        EQU GA_CMD_COLOR_SET|02 ; 19
GA_COLOR_BRIGHT_CYAN      EQU GA_CMD_COLOR_SET|19 ; 20
GA_COLOR_LIME_GREEN       EQU GA_CMD_COLOR_SET|26 ; 21
GA_COLOR_PASTEL_GREEN     EQU GA_CMD_COLOR_SET|25 ; 22
GA_COLOR_PASTEL_CYAN      EQU GA_CMD_COLOR_SET|27 ; 23
GA_COLOR_BRIGHT_YELLOW    EQU GA_CMD_COLOR_SET|10 ; 24
GA_COLOR_PASTEL_YELLOW    EQU GA_CMD_COLOR_SET|03 ; 25
GA_COLOR_BRIGHT_WHITE     EQU GA_CMD_COLOR_SET|11 ; 26



; CMD   IR UR LR  MODE 
; %100  0  0  0   00
GA_MODE0_ROMS_ON  EQU %10000000
GA_MODE1_ROMS_ON  EQU %10000001 
GA_MODE2_ROMS_ON  EQU %10000010
GA_MODE3_ROMS_ON  EQU %10000011
GA_MODE0_ROMS_OFF EQU %10001100
GA_MODE1_ROMS_OFF EQU %10001101 
GA_MODE2_ROMS_OFF EQU %10001110
GA_MODE3_ROMS_OFF EQU %10001111

